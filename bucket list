#include <bits/stdc++.h>

using namespace std;

#define int long long

signed main(){

    freopen("blist.in", "r", stdin);
    freopen("blist.out", "w", stdout);

    int n; cin >> n;

    vector<int> time (1001, 0);

    int buckets = 0;
    int max_buckets = 0;

    for (int i = 0; i < n; i++){
        int s, t, b; cin >> s >> t >> b;
        time[s] = b;
        time[t] = -b;
    }

    for (auto t : time){
        buckets += t;
        max_buckets = max(buckets, max_buckets);
    }

    cout << max_buckets << endl;

    return 0;
}
